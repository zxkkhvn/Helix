  "band_descriptions": {
    "none": "Your responses suggest no significant social anxiety. Most people experience occasional nervousness in social situations, and your responses fall within the typical range.",
    "mild": "Your responses indicate mild social anxiety. Most people experience this occasionally, but it is worth paying attention to if it begins to limit your activities.",
    "moderate": "Your responses suggest moderate social anxiety. Many people find it helpful to monitor this and gently challenge themselves in social settings.",
    "severe": "Your responses indicate severe social anxiety. This level of discomfort is significant, and exploring professional support could be highly beneficial."
