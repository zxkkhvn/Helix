  "items": [
    {
      "item_id": "compact_01",
      "text": "I can identify the things that really matter to me in life and pursue them.",
      "response_options_key": "compact_likert",
      "valence": "positive",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "compact_02",
      "text": "I try to distract myself when I feel unpleasant emotions.",
      "response_options_key": "compact_likert",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "compact_03",
      "text": "I rush through meaningful activities without being really attentive to them.",
      "response_options_key": "compact_likert",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "compact_04",
      "text": "I go out of my way to avoid situations that might bring up unpleasant thoughts and feelings in me.",
      "response_options_key": "compact_likert",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "compact_05",
      "text": "I act in ways that are consistent with how I wish to live my life.",
      "response_options_key": "compact_likert",
      "valence": "positive",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "compact_06",
      "text": "I work hard to keep out upsetting feelings.",
      "response_options_key": "compact_likert",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "compact_07",
      "text": "I undertake things that are meaningful to me, even when I find it hard to do so.",
      "response_options_key": "compact_likert",
      "valence": "positive",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "compact_08",
      "text": "I try to suppress thoughts and feelings that I don't like by just not thinking about them.",
      "response_options_key": "compact_likert",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "compact_09",
      "text": "I tend to get very entangled in my thoughts.",
      "response_options_key": "compact_likert",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "compact_10",
      "text": "I behave in line with my personal values.",
      "response_options_key": "compact_likert",
      "valence": "positive",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "compact_11",
      "text": "I get so caught up in my thoughts that I am unable to do the things that I most want to do.",
      "response_options_key": "compact_likert",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "compact_12",
      "text": "I find it difficult to stay focused on what's happening in the present.",
      "response_options_key": "compact_likert",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "compact_13",
      "text": "I try to stay busy to keep thoughts and feelings from coming.",
      "response_options_key": "compact_likert",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "compact_14",
      "text": "I make choices based on what is important to me, even if it is stressful.",
      "response_options_key": "compact_likert",
      "valence": "positive",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "compact_15",
      "text": "One of my big goals is to be free from painful emotions.",
      "response_options_key": "compact_likert",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "compact_16",
      "text": "I do jobs or tasks automatically, without being aware of what I'm doing.",
      "response_options_key": "compact_likert",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "compact_17",
      "text": "I am able to follow my long-term plans including times when progress is slow.",
      "response_options_key": "compact_likert",
      "valence": "positive",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "compact_18",
      "text": "Even when something is important to me, I'll rarely do it if there is a chance it will upset me.",
      "response_options_key": "compact_likert",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "compact_19",
      "text": "It seems I am 'running on automatic' without much awareness of what I'm doing.",
      "response_options_key": "compact_likert",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "compact_20",
      "text": "I am willing to suffer for the things that matter to me.",
      "response_options_key": "compact_likert",
      "valence": "positive",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "compact_21",
      "text": "I persevere with a task in order to get closer to what I want in life.",
      "response_options_key": "compact_likert",
      "valence": "positive",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "compact_22",
      "text": "I tell myself that I shouldn't have certain thoughts.",
      "response_options_key": "compact_likert",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "compact_23",
      "text": "I continue working toward my goals even when I doubt I can succeed.",
      "response_options_key": "compact_likert",
      "valence": "positive",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    }
  ],
