  "items": [
    {
      "item_id": "erq_01",
      "text": "When I want to feel more positive emotion (such as joy or amusement), I change what I’m thinking about.",
      "response_options_key": "erq_likert",
      "valence": "positive",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "erq_02",
      "text": "I keep my emotions to myself.",
      "response_options_key": "erq_likert",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "erq_03",
      "text": "When I want to feel less negative emotion (such as sadness or anger), I change what I’m thinking about.",
      "response_options_key": "erq_likert",
      "valence": "positive",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "erq_04",
      "text": "When I am feeling positive emotions, I am careful not to express them.",
      "response_options_key": "erq_likert",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "erq_05",
      "text": "When I’m faced with a stressful situation, I make myself think about it in a way that helps me stay calm.",
      "response_options_key": "erq_likert",
      "valence": "positive",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "erq_06",
      "text": "I control my emotions by not expressing them.",
      "response_options_key": "erq_likert",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "erq_07",
      "text": "When I want to feel more positive emotion, I change the way I’m thinking about the situation.",
      "response_options_key": "erq_likert",
      "valence": "positive",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "erq_08",
      "text": "I control my emotions by changing the way I think about the situation I’m in.",
      "response_options_key": "erq_likert",
      "valence": "positive",
