      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "erq_09",
      "text": "When I am feeling negative emotions, I make sure not to express them.",
      "response_options_key": "erq_likert",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "erq_10",
      "text": "When I want to feel less negative emotion, I change the way I’m thinking about the situation.",
      "response_options_key": "erq_likert",
      "valence": "positive",
