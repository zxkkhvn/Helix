{
  "instrument_id": "psqi",
  "version": "1.0.0",
  "name": "Pittsburgh Sleep Quality Index",
  "abbreviation": "PSQI",
  "planet": "mercury",
  "tier": "deep_dive",
  "time_window": "past_month",
  "time_window_text": "The following questions relate to your usual sleep habits during the past month only. Your answers should indicate the most accurate reply for the majority of days and nights in the past month.",
  "time_window_days": 30,
  "cultural_validity": {
    "tier": "broadly_cross_cultural",
    "caveat_text": null
  },
  "licence_status": "public_domain",
  "sensitive_content": false,
  "sensitive_content_warning": null,
  "calibration_signal": null,
  "min_trials_for_partial_scoring": null,
  "composite_contributions": [],
  "consistency_pairs": [],

  "response_option_sets": {
    "psqi_frequency": [
      {"value": 0, "label": "Not during the past month"},
      {"value": 1, "label": "Less than once a week"},
      {"value": 2, "label": "Once or twice a week"},
      {"value": 3, "label": "Three or more times a week"}
    ],
    "psqi_quality": [
      {"value": 0, "label": "Very good"},
      {"value": 1, "label": "Fairly good"},
      {"value": 2, "label": "Fairly bad"},
      {"value": 3, "label": "Very bad"}
    ],
    "psqi_problem": [
      {"value": 0, "label": "No problem at all"},
      {"value": 1, "label": "Only a very slight problem"},
      {"value": 2, "label": "Somewhat of a problem"},
      {"value": 3, "label": "A very big problem"}
    ],
    "free_text_time": [
      {"value": -1, "label": "Time entry (e.g. 10:30 PM)"}
    ],
    "free_text_number": [
      {"value": -1, "label": "Number entry"}
    ]
  },

  "items": [
