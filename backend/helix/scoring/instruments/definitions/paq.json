      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "paq_17",
      "text": "I prefer to just let things happen rather than to understand why they turned out that way.",
      "response_options_key": "paq_likert",
      "valence": "general",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "paq_18",
      "text": "I tend to ignore how I feel.",
      "response_options_key": "paq_likert",
      "valence": "general",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "paq_19",
      "text": "I prefer to focus on factual events rather than the deeper meaning of things.",
