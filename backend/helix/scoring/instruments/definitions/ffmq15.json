      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "ffmq15_02",
      "text": "I don’t pay attention to what I’m doing because I’m daydreaming, worrying, or otherwise distracted.",
      "response_options_key": "ffmq_likert",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "ffmq15_03",
      "text": "I am easily distracted.",
