      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "ffmq15_07",
      "text": "I notice how foods and drinks affect my thoughts, bodily sensations, and emotions.",
      "response_options_key": "ffmq_likert",
      "valence": "positive",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "ffmq15_08",
      "text": "I pay attention to sensations, such as the wind in my hair or sun on my face.",
      "response_options_key": "ffmq_likert",
      "valence": "positive",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "ffmq15_09",
      "text": "I pay attention to sounds, such as clocks ticking, birds chirping, or cars passing.",
      "response_options_key": "ffmq_likert",
      "valence": "positive",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "ffmq15_10",
      "text": "It’s hard for me to find the words to describe what I’m thinking.",
      "response_options_key": "ffmq_likert",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "ffmq15_11",
      "text": "I have trouble thinking of the right words to express how I feel about things.",
