      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "ffmq15_05",
      "text": "I believe some of my thoughts are abnormal or bad and I shouldn’t think that way.",
