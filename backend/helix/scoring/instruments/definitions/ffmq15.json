      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "ffmq15_06",
      "text": "I think some of my emotions are bad or inappropriate and I shouldn’t feel them.",
