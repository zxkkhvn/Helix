  "items": [
    {
      "item_id": "rses_01",
      "text": "I feel that I'm a person of worth, at least on an equal plane with others.",
      "response_options_key": "likert4"
    },
    {
      "item_id": "rses_02",
      "text": "I feel that I have a number of good qualities.",
