  "items": [
    {
      "item_id": "oci_r_01",
      "text": "I have saved up so many things that they get in the way.",
      "response_options_key": "oci_5pt",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "oci_r_02",
      "text": "I check things more often than necessary.",
      "response_options_key": "oci_5pt",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "oci_r_03",
      "text": "I get upset if objects are not arranged properly.",
      "response_options_key": "oci_5pt",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "oci_r_04",
      "text": "I feel compelled to count while I am doing things.",
      "response_options_key": "oci_5pt",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "oci_r_05",
      "text": "I find it difficult to touch an object when I know it has been touched by strangers or certain people.",
      "response_options_key": "oci_5pt",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "oci_r_06",
      "text": "I find it difficult to control my own thoughts.",
      "response_options_key": "oci_5pt",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "oci_r_07",
      "text": "I collect things I don't need.",
      "response_options_key": "oci_5pt",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "oci_r_08",
      "text": "I repeatedly check doors, windows, drawers, etc.",
      "response_options_key": "oci_5pt",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "oci_r_09",
      "text": "I get upset if others change the way I have arranged things.",
      "response_options_key": "oci_5pt",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "oci_r_10",
      "text": "I feel I have to repeat certain numbers.",
      "response_options_key": "oci_5pt",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "oci_r_11",
      "text": "I sometimes have to wash or clean myself simply because I feel contaminated.",
      "response_options_key": "oci_5pt",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "oci_r_12",
      "text": "I am upset by unpleasant thoughts that come into my mind against my will.",
      "response_options_key": "oci_5pt",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "oci_r_13",
      "text": "I avoid throwing things away because I am afraid I might need them later.",
      "response_options_key": "oci_5pt",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "oci_r_14",
      "text": "I repeatedly check gas and water taps and light switches after turning them off.",
      "response_options_key": "oci_5pt",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "oci_r_15",
      "text": "I need things to be arranged in a particular order.",
      "response_options_key": "oci_5pt",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "oci_r_16",
      "text": "I feel that there are good and bad numbers.",
      "response_options_key": "oci_5pt",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "oci_r_17",
      "text": "I wash my hands more often and longer than necessary.",
      "response_options_key": "oci_5pt",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "oci_r_18",
