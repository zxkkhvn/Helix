  "band_descriptions": {
    "none": "Your responses suggest no significant social anxiety. Most people experience occasional nervousness in social settings, and your responses fall within the typical range.",
    "mild": "Your responses indicate mild social anxiety. Most people experience this occasionally, but it is worth paying attention to if it limits your daily life.",
    "moderate": "Your responses suggest moderate social anxiety. Many people find it helpful to monitor this and practise gradual engagement with feared situations.",
    "marked": "Your responses indicate marked social anxiety. This level of fear and avoidance is worth paying attention to, and exploring supportive strategies can be very helpful.",
    "severe": "Your responses suggest severe social anxiety. The distress you are feeling in social situations is significant, and professional guidance could provide valuable support.",
    "very_severe": "Your responses indicate very severe social anxiety. This level of difficulty is highly validating of your distress, and professional support is strongly recommended."
  }
