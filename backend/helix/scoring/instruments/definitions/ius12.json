  "items": [
    {
      "item_id": "ius12_01",
      "text": "Unforeseen events upset me greatly.",
      "response_options_key": "ius_5pt",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "ius12_02",
      "text": "It frustrates me not having all the information I need.",
      "response_options_key": "ius_5pt",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "ius12_03",
      "text": "Uncertainty keeps me from living a full life.",
      "response_options_key": "ius_5pt",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "ius12_04",
      "text": "One should always look ahead so as to avoid surprises.",
      "response_options_key": "ius_5pt",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "ius12_05",
      "text": "A small unforeseen event can spoil everything, even with the best of planning.",
      "response_options_key": "ius_5pt",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "ius12_06",
      "text": "When it\u2019s time to act, uncertainty paralyses me.",
      "response_options_key": "ius_5pt",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "ius12_07",
      "text": "When I am uncertain I can\u2019t function very well.",
      "response_options_key": "ius_5pt",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "ius12_08",
      "text": "I always want to know what the future has in store for me.",
      "response_options_key": "ius_5pt",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "ius12_09",
      "text": "I can\u2019t stand being taken by surprise.",
      "response_options_key": "ius_5pt",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "ius12_10",
      "text": "The smallest doubt can stop me from acting.",
      "response_options_key": "ius_5pt",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "ius12_11",
      "text": "I should be able to organize everything in advance.",
      "response_options_key": "ius_5pt",
      "valence": "negative",
      "exclude_from_score": false,
      "safety_flag": false,
      "safety_trigger": null
    },
    {
      "item_id": "ius12_12",
      "text": "I must get away from all uncertain situations.",
      "response_options_key": "ius_5pt",
      "valence": "negative",
      "exclude_from_score": false,
