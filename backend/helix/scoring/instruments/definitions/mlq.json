  "band_descriptions": {
    "presence": {
      "low": "Your responses suggest a low sense of meaning currently present in your life. Many people go through periods where meaning feels elusive, and this can be a valuable area to explore.",
      "moderate": "Your responses indicate a moderate sense of meaning present in your life. Most people experience fluctuations in how meaningful their daily experiences feel, and your responses fall within the typical range.",
      "high": "Your responses suggest a strong sense of meaning present in your life. This indicates you have a clear sense of what matters to you and how your daily experiences connect to it."
    },
    "search": {
      "low": "Your responses suggest a low level of active searching for meaning. This may reflect that meaning feels settled for you, or that this is not a current focus of your attention.",
      "moderate": "Your responses indicate a moderate level of searching for meaning. Many people find themselves actively questioning what matters to them at certain points in life, and your responses fall within the typical range.",
      "high": "Your responses suggest an active and intense search for meaning. This is a deeply human experience, and exploring your values and what gives you a sense of purpose could be a rich area for reflection."
    }
